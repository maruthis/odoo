    <record id="seq_newsletter_compliance_alert" model="ir.sequence">
        <field name="name">Newsletter Compliance Alert</field>
        <field name="code">newsletter.compliance.alert</field>
        <field name="prefix">ALRT-%(year)s-</field>
        <field name="padding">6</field>
    </record>
</odoo>
