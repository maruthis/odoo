<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_newsletter_retention_action_list" model="ir.ui.view">
        <field name="name">newsletter.retention.action.list</field>
        <field name="model">newsletter.retention.action</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="reference"/>
                <field name="executed_at"/>
                <field name="policy_id"/>
                <field name="model_name"/>
                <field name="record_reference"/>
                <field name="action_type"/>
                <field name="result"/>
                <field name="dry_run"/>
                <field name="executed_by_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_newsletter_retention_action_form" model="ir.ui.view">
        <field name="name">newsletter.retention.action.form</field>
        <field name="model">newsletter.retention.action</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="reference" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Target">
                            <field name="policy_id"/>
                            <field name="model_name"/>
                            <field name="record_reference"/>
                            <field name="record_res_id"/>
                            <field name="privacy_request_id"/>
                        </group>
                        <group string="Result">
                            <field name="action_type"/>
                            <field name="result"/>
                            <field name="dry_run"/>
                            <field name="error_message"/>
                        </group>
                    </group>
                    <group>
                        <group string="Execution">
                            <field name="executed_at"/>
                            <field name="executed_by_id"/>
                            <field name="legal_hold_checked"/>
                        </group>
                        <group string="Identity / Evidence">
                            <field name="previous_identity_state"/>
                            <field name="new_identity_state"/>
                            <field name="evidence_hash_before"/>
                            <field name="evidence_hash_after"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_newsletter_retention_action_search" model="ir.ui.view">
        <field name="name">newsletter.retention.action.search</field>
        <field name="model">newsletter.retention.action</field>
        <field name="arch" type="xml">
            <search>
                <field name="reference"/>
                <field name="policy_id"/>
                <field name="model_name"/>
                <field name="record_reference"/>
                <filter name="failed" string="Failed" domain="[('result', '=', 'failed')]"/>
                <filter name="blocked" string="Blocked" domain="[('result', '=', 'blocked')]"/>
                <filter name="dry_run" string="Dry-Run" domain="[('dry_run', '=', True)]"/>
                <group>
                    <filter name="group_by_policy" string="Policy" context="{'group_by': 'policy_id'}"/>
                    <filter name="group_by_action_type" string="Action Type" context="{'group_by': 'action_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_newsletter_retention_action" model="ir.actions.act_window">
        <field name="name">Retention Action Ledger</field>
        <field name="res_model">newsletter.retention.action</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_newsletter_retention_action_search"/>
    </record>

    <record id="action_newsletter_retention_action_exceptions" model="ir.actions.act_window">
        <field name="name">Retention Exceptions</field>
        <field name="res_model">newsletter.retention.action</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_newsletter_retention_action_search"/>
        <field name="domain">[('result', 'in', ('failed', 'blocked'))]</field>
        <field name="context">{'search_default_failed': 0}</field>
    </record>
</odoo>
