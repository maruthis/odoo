<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_newsletter_delivery_reputation_list" model="ir.ui.view">
        <field name="name">newsletter.delivery.reputation.list</field>
        <field name="model">newsletter.delivery.reputation</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0"
                  decoration-danger="reputation_state == 'suppressed'"
                  decoration-warning="reputation_state == 'warning'">
                <field name="email_normalized"/>
                <field name="partner_id"/>
                <field name="reputation_state"/>
                <field name="soft_bounce_count"/>
                <field name="hard_bounce_count"/>
                <field name="complaint_count"/>
                <field name="last_delivery_at"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_newsletter_delivery_reputation_form" model="ir.ui.view">
        <field name="name">newsletter.delivery.reputation.form</field>
        <field name="model">newsletter.delivery.reputation</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="email_normalized" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="reputation_state"/>
                        </group>
                    </group>
                    <group string="Soft Bounces">
                        <field name="soft_bounce_count"/>
                        <field name="lifetime_soft_bounce_count"/>
                        <field name="last_soft_bounce_at"/>
                    </group>
                    <group string="Hard Bounces">
                        <field name="hard_bounce_count"/>
                        <field name="last_hard_bounce_at"/>
                    </group>
                    <group string="Complaints">
                        <field name="complaint_count"/>
                        <field name="last_complaint_at"/>
                    </group>
                    <group string="Delivery">
                        <field name="last_delivery_at"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_newsletter_delivery_reputation_search" model="ir.ui.view">
        <field name="name">newsletter.delivery.reputation.search</field>
        <field name="model">newsletter.delivery.reputation</field>
        <field name="arch" type="xml">
            <search>
                <field name="email_normalized"/>
                <field name="partner_id"/>
                <filter name="filter_suppressed" string="Suppressed" domain="[('reputation_state', '=', 'suppressed')]"/>
                <filter name="filter_warning" string="Warning" domain="[('reputation_state', '=', 'warning')]"/>
                <group>
                    <filter name="group_by_state" string="State" context="{'group_by': 'reputation_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_newsletter_delivery_reputation" model="ir.actions.act_window">
        <field name="name">Recipient Reputation</field>
        <field name="res_model">newsletter.delivery.reputation</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_newsletter_delivery_reputation_search"/>
    </record>
</odoo>
