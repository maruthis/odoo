<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_newsletter_reset_campaign_wizard_form" model="ir.ui.view">
        <field name="name">newsletter.reset.campaign.wizard.form</field>
        <field name="model">newsletter.reset.campaign.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="mailing_id" invisible="1"/>
                    <field name="reason"/>
                    <field name="comments"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Return to Draft"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_newsletter_reset_campaign_wizard" model="ir.actions.act_window">
        <field name="name">Return to Draft</field>
        <field name="res_model">newsletter.reset.campaign.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
