<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_newsletter_audit_export_wizard_form" model="ir.ui.view">
        <field name="name">newsletter.audit.export.wizard.form</field>
        <field name="model">newsletter.audit.export.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="campaign_run_id" invisible="1"/>
                    <field name="masked"/>
                    <field name="purpose"/>
                </group>
                <footer>
                    <button name="action_generate" string="Generate Export"
                            type="object" class="btn-primary"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_newsletter_audit_export_wizard" model="ir.actions.act_window">
        <field name="name">Generate Campaign Audit Export</field>
        <field name="res_model">newsletter.audit.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
