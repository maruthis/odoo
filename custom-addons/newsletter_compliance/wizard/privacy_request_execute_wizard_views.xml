<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_newsletter_privacy_request_execute_wizard_form" model="ir.ui.view">
        <field name="name">newsletter.privacy.request.execute.wizard.form</field>
        <field name="model">newsletter.privacy.request.execute.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="privacy_request_id" invisible="1"/>
                    <field name="confirmation_text"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Execute"
                            type="object" class="btn-primary"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_newsletter_privacy_request_execute_wizard" model="ir.actions.act_window">
        <field name="name">Execute Privacy Request</field>
        <field name="res_model">newsletter.privacy.request.execute.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
