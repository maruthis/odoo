<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_newsletter_legal_hold_release_wizard_form" model="ir.ui.view">
        <field name="name">newsletter.legal.hold.release.wizard.form</field>
        <field name="model">newsletter.legal.hold.release.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="legal_hold_id" invisible="1"/>
                    <field name="reason"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Release Hold"
                            type="object" class="btn-primary"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_newsletter_legal_hold_release_wizard" model="ir.actions.act_window">
        <field name="name">Release Legal Hold</field>
        <field name="res_model">newsletter.legal.hold.release.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
