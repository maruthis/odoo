<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_newsletter_withdraw_consent_wizard_form" model="ir.ui.view">
        <field name="name">newsletter.withdraw.consent.wizard.form</field>
        <field name="model">newsletter.withdraw.consent.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="consent_id" invisible="1"/>
                    <field name="withdrawal_date"/>
                    <field name="withdrawal_source"/>
                    <field name="reason"/>
                    <field name="create_suppression"/>
                    <field name="suppression_scope" invisible="not create_suppression"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Withdraw Consent"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_newsletter_withdraw_consent_wizard" model="ir.actions.act_window">
        <field name="name">Withdraw Consent</field>
        <field name="res_model">newsletter.withdraw.consent.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
