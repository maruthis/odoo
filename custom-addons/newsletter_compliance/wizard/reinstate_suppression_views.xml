<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_newsletter_reinstate_suppression_wizard_form" model="ir.ui.view">
        <field name="name">newsletter.reinstate.suppression.wizard.form</field>
        <field name="model">newsletter.reinstate.suppression.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="suppression_id" invisible="1"/>
                    <field name="reinstatement_reason"/>
                    <field name="evidence_reference"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Reinstate"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_newsletter_reinstate_suppression_wizard" model="ir.actions.act_window">
        <field name="name">Reinstate Suppression</field>
        <field name="res_model">newsletter.reinstate.suppression.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
