<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_newsletter_retention_preview_wizard_form" model="ir.ui.view">
        <field name="name">newsletter.retention.preview.wizard.form</field>
        <field name="model">newsletter.retention.preview.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="policy_id" invisible="1"/>
                    <field name="preview_result" readonly="1" invisible="not preview_result"/>
                </group>
                <footer>
                    <button name="action_preview" string="Preview"
                            type="object" class="btn-primary"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_newsletter_retention_preview_wizard" model="ir.actions.act_window">
        <field name="name">Preview Retention Policy Impact</field>
        <field name="res_model">newsletter.retention.preview.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
